map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

limit_req_zone $binary_remote_addr zone=clipbridge_api:10m rate=10r/s;

server {
    listen 80;
    server_name ${CLIPBRIDGE_DOMAIN};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CLIPBRIDGE_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${CLIPBRIDGE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CLIPBRIDGE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 64k;

    location /api/v1/ws {
        limit_req zone=clipbridge_api burst=30 nodelay;
        proxy_pass http://relay:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 75s;
        proxy_send_timeout 15s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
    }

    location /dashboard {
        alias /usr/share/nginx/html/dashboard;
        index index.html;
    }

    location / {
        limit_req zone=clipbridge_api burst=20 nodelay;
        proxy_pass http://relay:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}

