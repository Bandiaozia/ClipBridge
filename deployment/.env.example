# 复制为 .env；所有示例值都必须替换。
CLIPBRIDGE_DOMAIN=clipbridge.example.com
CLIPBRIDGE_JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
CLIPBRIDGE_ALLOWED_ORIGIN=
CLIPBRIDGE_HTTP_PORT=8080
CLIPBRIDGE_LOG_LEVEL=info
CLIPBRIDGE_MAX_QUEUED_MESSAGES=1000
CLIPBRIDGE_MAX_QUEUED_BYTES=10485760
CLIPBRIDGE_VERSION=local
DASHBOARD_PASSWORD=choose-a-strong-password

